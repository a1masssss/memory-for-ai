APP_NAME=memory-service
DATABASE_URL=postgresql://memory:memory@postgres:5432/memory

# Optional. If set later, routes can enforce Authorization: Bearer <token>.
MEMORY_AUTH_TOKEN=

# Optional. Enables LLM-based extraction when present.
# Without this key the service falls back to deterministic local extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_ENABLED=true
OPENAI_EMBEDDING_ENABLED=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=20
EMBEDDING_DIMENSIONS=64

POSTGRES_DB=memory
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
